@@ -104,7 +104,13 @@ class MultipleEnvironmentMNIST(MultipleDomainDataset):
         original_labels = torch.cat((original_dataset_tr.targets,
                                      original_dataset_te.targets))
 
-        shuffle = torch.randperm(len(original_images))
+        # Seeded (was torch.randperm(len(original_images)) with no seed,
+        # using PyTorch's global RNG — made every separate process
+        # invocation produce a different shuffle, hence a different
+        # synthetic dataset, not just a different split of the same one).
+        _shuffle_rng = torch.Generator()
+        _shuffle_rng.manual_seed(0)
+        shuffle = torch.randperm(len(original_images), generator=_shuffle_rng)
 
         original_images = original_images[shuffle]
         original_labels = original_labels[shuffle]
